{
  "entities": {
    "ShopSettings": {
      "title": "ShopSettings",
      "description": "Shop profile, editable shop name, currency (MMK), and default pricing margin settings owned by a user.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "shopName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "shopSubtitle": { "type": "string", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 40 },
        "address": { "type": "string", "maxLength": 240 },
        "receiptFooter": { "type": "string", "maxLength": 240 },
        "currency": { "type": "string", "enum": ["MMK"] },
        "defaultMarginPercent": { "type": "number" },
        "telegramEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "shopName", "currency", "defaultMarginPercent", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Inventory product with MMK cost price, profit margin percentage, calculated sell price, and stock levels.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sku": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 140 },
        "category": { "type": "string", "minLength": 1, "maxLength": 64 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 32 },
        "costPrice": { "type": "number" },
        "marginPercent": { "type": "number" },
        "sellPrice": { "type": "number" },
        "stock": { "type": "number" },
        "minStock": { "type": "number" },
        "imageUrl": { "type": "string", "maxLength": 180000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "sku", "name", "category", "unit", "costPrice", "marginPercent", "sellPrice", "stock", "minStock", "createdAt", "updatedAt"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Completed POS sale invoice with bounded line items, profit calculation, payment method, and MMK totals.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "voucherNo": { "type": "string", "minLength": 1, "maxLength": 48 },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "customerName": { "type": "string", "maxLength": 120 },
        "customerPhone": { "type": "string", "maxLength": 40 },
        "paymentMethod": { "type": "string", "enum": ["cash", "kbzpay", "wavepay", "credit"] },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "totalCost": { "type": "number" },
        "profit": { "type": "number" },
        "paidAmount": { "type": "number" },
        "note": { "type": "string", "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "voucherNo", "date", "paymentMethod", "items", "subtotal", "discount", "total", "totalCost", "profit", "paidAmount", "createdAt", "updatedAt"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "Supplier stock purchase order that replenishes inventory and tracks cost price.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "refNo": { "type": "string", "minLength": 1, "maxLength": 48 },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "supplierName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["paid", "credit"] },
        "note": { "type": "string", "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "refNo", "date", "supplierName", "items", "totalAmount", "paidAmount", "status", "createdAt", "updatedAt"]
    },
    "StockLog": {
      "title": "StockLog",
      "description": "Audit log of inventory inflows, outflows, and manual adjustments.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productName": { "type": "string", "minLength": 1, "maxLength": 140 },
        "type": { "type": "string", "enum": ["in", "out", "adjust"] },
        "quantity": { "type": "number" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 200 },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "productId", "productName", "type", "quantity", "previousStock", "newStock", "reason", "date", "createdAt"]
    },
    "Debt": {
      "title": "Debt",
      "description": "Customer receivable or supplier payable debt ledger record.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["receivable", "payable"] },
        "partyName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 40 },
        "referenceNo": { "type": "string", "maxLength": 48 },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "dueDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "status": { "type": "string", "enum": ["pending", "partial", "settled"] },
        "note": { "type": "string", "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "type", "partyName", "totalAmount", "paidAmount", "remainingAmount", "dueDate", "status", "createdAt", "updatedAt"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Shop operating expense entry in MMK.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "category": { "type": "string", "minLength": 1, "maxLength": 64 },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "amount": { "type": "number" },
        "note": { "type": "string", "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "date", "category", "title", "amount", "createdAt", "updatedAt"]
    },
    "Delivery": {
      "title": "Delivery",
      "description": "Order delivery dispatch and Cash-on-Delivery tracking record.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "voucherNo": { "type": "string", "minLength": 1, "maxLength": 48 },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 40 },
        "address": { "type": "string", "minLength": 1, "maxLength": 240 },
        "courierName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "deliveryFee": { "type": "number" },
        "codAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "dispatched", "delivered", "cancelled"] },
        "note": { "type": "string", "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "voucherNo", "date", "customerName", "address", "courierName", "deliveryFee", "codAmount", "status", "createdAt", "updatedAt"]
    },
    "AccessPass": {
      "title": "AccessPass",
      "description": "Admin-issued random access pass with server-enforced expiry timestamp, status, device limits, and Gmail account binding.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 6, "maxLength": 40, "pattern": "^[A-Z0-9\\-]+$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "note": { "type": "string", "maxLength": 240 },
        "status": { "type": "string", "enum": ["active", "revoked"] },
        "durationDays": { "type": "number" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "subscription_expiry": { "type": "string", "format": "date-time" },
        "maxDevices": { "type": "number" },
        "boundDevices": { "type": "array" },
        "assignedUid": { "type": "string", "maxLength": 128 },
        "assignedEmail": { "type": "string", "maxLength": 160 },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "label", "status", "durationDays", "expiresAt", "maxDevices", "boundDevices", "createdBy", "createdAt", "updatedAt"]
    },
    "UserLicense": {
      "title": "UserLicense",
      "description": "Active time-limited license entitlement bound to a user's Firebase UID and verified against an Admin-issued AccessPass.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 160 },
        "displayName": { "type": "string", "maxLength": 120 },
        "passCode": { "type": "string", "minLength": 6, "maxLength": 40, "pattern": "^[A-Z0-9\\-]+$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "status": { "type": "string", "enum": ["active", "revoked"] },
        "expiresAt": { "type": "string", "format": "date-time" },
        "subscription_expiry": { "type": "string", "format": "date-time" },
        "maxDevices": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "passCode", "label", "status", "expiresAt", "maxDevices", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/accessPasses/{passCode}": {
      "schema": { "$ref": "#/entities/AccessPass" },
      "description": "Admin-managed random access passes keyed by pass code."
    },
    "/userLicenses/{userId}": {
      "schema": { "$ref": "#/entities/UserLicense" },
      "description": "Per-user active access license bound to the user's UID."
    },
    "/shops/{shopId}": {
      "schema": { "$ref": "#/entities/ShopSettings" },
      "description": "Root shop profile and settings document keyed by owner UID."
    },
    "/shops/{shopId}/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Inventory catalog belonging to a shop."
    },
    "/shops/{shopId}/sales/{saleId}": {
      "schema": { "$ref": "#/entities/Sale" },
      "description": "POS sales invoices belonging to a shop."
    },
    "/shops/{shopId}/purchases/{purchaseId}": {
      "schema": { "$ref": "#/entities/Purchase" },
      "description": "Supplier purchase records belonging to a shop."
    },
    "/shops/{shopId}/stockLogs/{logId}": {
      "schema": { "$ref": "#/entities/StockLog" },
      "description": "Inventory movement audit logs belonging to a shop."
    },
    "/shops/{shopId}/debts/{debtId}": {
      "schema": { "$ref": "#/entities/Debt" },
      "description": "Customer receivables and supplier payables belonging to a shop."
    },
    "/shops/{shopId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Operating expenses belonging to a shop."
    },
    "/shops/{shopId}/deliveries/{deliveryId}": {
      "schema": { "$ref": "#/entities/Delivery" },
      "description": "Delivery orders and COD tracking belonging to a shop."
    }
  }
}
