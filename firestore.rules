rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Hardened Global Primitives
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPassCode(code) {
      return code is string && code.size() >= 6 && code.size() <= 40 && code.matches('^[A-Z0-9\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Zero-lookup primary admin helper (safe for allow list queries)
    function isPrimaryAdmin() {
      return isVerified() && request.auth.token.email == 'loveking20178@gmail.com';
    }

    function isAdmin() {
      return isPrimaryAdmin() || (
        isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isNotExpiredDoc(data) {
      return data.expiresAt > request.time
        && (!('subscription_expiry' in data) || (data.subscription_expiry is timestamp && data.subscription_expiry > request.time));
    }

    function hasActiveLicense() {
      return isAdmin() || (
        isVerified()
        && exists(/databases/$(database)/documents/userLicenses/$(request.auth.uid))
        && get(/databases/$(database)/documents/userLicenses/$(request.auth.uid)).data.status == 'active'
        && isNotExpiredDoc(get(/databases/$(database)/documents/userLicenses/$(request.auth.uid)).data)
        && exists(/databases/$(database)/documents/accessPasses/$(get(/databases/$(database)/documents/userLicenses/$(request.auth.uid)).data.passCode))
        && get(/databases/$(database)/documents/accessPasses/$(get(/databases/$(database)/documents/userLicenses/$(request.auth.uid)).data.passCode)).data.status == 'active'
        && isNotExpiredDoc(get(/databases/$(database)/documents/accessPasses/$(get(/databases/$(database)/documents/userLicenses/$(request.auth.uid)).data.passCode)).data)
      );
    }

    function isShopOwner(shopId) {
      return isSignedIn()
        && shopId == request.auth.uid
        && hasActiveLicense()
        && exists(/databases/$(database)/documents/shops/$(shopId))
        && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
    }

    function isValidDateString(val) {
      return val is string && val.size() == 10 && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isOptString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints (Anti-Update-Gap)
    // -------------------------------------------------------------------------
    function isValidAccessPass(data) {
      return data.keys().hasAll(['code', 'label', 'status', 'durationDays', 'expiresAt', 'maxDevices', 'boundDevices', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['code', 'label', 'note', 'status', 'durationDays', 'expiresAt', 'subscription_expiry', 'maxDevices', 'boundDevices', 'assignedUid', 'assignedEmail', 'createdBy', 'createdAt', 'updatedAt'])
        && isValidPassCode(data.code)
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 120
        && isOptString(data, 'note', 240)
        && data.status in ['active', 'revoked']
        && data.durationDays is number && data.durationDays >= 1 && data.durationDays <= 3650
        && data.expiresAt is timestamp
        && (!('subscription_expiry' in data) || data.subscription_expiry is timestamp)
        && data.maxDevices is number && data.maxDevices >= 1 && data.maxDevices <= 50
        && data.boundDevices is list && data.boundDevices.size() <= 50
        && (data.boundDevices.size() == 0 || (data.boundDevices[0] is string && data.boundDevices[0].size() <= 128))
        && isOptString(data, 'assignedUid', 128)
        && isOptString(data, 'assignedEmail', 160)
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserLicense(data) {
      return data.keys().hasAll(['userId', 'email', 'passCode', 'label', 'status', 'expiresAt', 'maxDevices', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'email', 'displayName', 'passCode', 'label', 'status', 'expiresAt', 'subscription_expiry', 'maxDevices', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && isOptString(data, 'displayName', 120)
        && isValidPassCode(data.passCode)
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 120
        && data.status in ['active', 'revoked']
        && data.expiresAt is timestamp
        && (!('subscription_expiry' in data) || data.subscription_expiry is timestamp)
        && data.maxDevices is number && data.maxDevices >= 1 && data.maxDevices <= 50
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidShop(data, shopId) {
      return data.keys().hasAll(['ownerId', 'shopName', 'currency', 'defaultMarginPercent', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'shopName', 'shopSubtitle', 'phone', 'address', 'receiptFooter', 'currency', 'defaultMarginPercent', 'telegramEnabled', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == shopId
        && (data.ownerId == request.auth.uid || isAdmin())
        && data.shopName is string && data.shopName.size() >= 1 && data.shopName.size() <= 120
        && isOptString(data, 'shopSubtitle', 160)
        && isOptString(data, 'phone', 40)
        && isOptString(data, 'address', 240)
        && isOptString(data, 'receiptFooter', 240)
        && data.currency == 'MMK'
        && data.defaultMarginPercent is number && data.defaultMarginPercent >= 0 && data.defaultMarginPercent <= 1000
        && (!('telegramEnabled' in data) || data.telegramEnabled is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProduct(data, shopId) {
      return data.keys().hasAll(['ownerId', 'sku', 'name', 'category', 'unit', 'costPrice', 'marginPercent', 'sellPrice', 'stock', 'minStock', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'sku', 'name', 'category', 'unit', 'costPrice', 'marginPercent', 'sellPrice', 'stock', 'minStock', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == shopId
        && (data.ownerId == request.auth.uid || isAdmin())
        && data.sku is string && data.sku.size() >= 1 && data.sku.size() <= 64
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 140
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 64
        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 32
        && data.costPrice is number && data.costPrice >= 0 && data.costPrice <= 1000000000
        && data.marginPercent is number && data.marginPercent >= 0 && data.marginPercent <= 10000
        && data.sellPrice is number && data.sellPrice >= 0 && data.sellPrice <= 1000000000
        && data.stock is number && data.stock >= -1000000 && data.stock <= 100000000
        && data.minStock is number && data.minStock >= 0 && data.minStock <= 10000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSale(data, shopId) {
      return data.keys().hasAll(['ownerId', 'voucherNo', 'date', 'paymentMethod', 'items', 'subtotal', 'discount', 'total', 'totalCost', 'profit', 'paidAmount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'voucherNo', 'date', 'customerName', 'customerPhone', 'paymentMethod', 'items', 'subtotal', 'discount', 'total', 'totalCost', 'profit', 'paidAmount', 'note', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == shopId
        && (data.ownerId == request.auth.uid || isAdmin())
        && data.voucherNo is string && data.voucherNo.size() >= 1 && data.voucherNo.size() <= 48
        && isValidDateString(data.date)
        && isOptString(data, 'customerName', 120)
        && isOptString(data, 'customerPhone', 40)
        && data.paymentMethod in ['cash', 'kbzpay', 'wavepay', 'credit']
        && data.items is list && data.items.size() > 0 && data.items.size() <= 100 && data.items[0] is map
        && data.subtotal is number && data.subtotal >= 0
        && data.discount is number && data.discount >= 0
        && data.total is number && data.total >= 0
        && data.totalCost is number && data.totalCost >= 0
        && data.profit is number
        && data.paidAmount is number && data.paidAmount >= 0
        && isOptString(data, 'note', 240)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPurchase(data, shopId) {
      return data.keys().hasAll(['ownerId', 'refNo', 'date', 'supplierName', 'items', 'totalAmount', 'paidAmount', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'refNo', 'date', 'supplierName', 'items', 'totalAmount', 'paidAmount', 'status', 'note', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == shopId
        && (data.ownerId == request.auth.uid || isAdmin())
        && data.refNo is string && data.refNo.size() >= 1 && data.refNo.size() <= 48
        && isValidDateString(data.date)
        && data.supplierName is string && data.supplierName.size() >= 1 && data.supplierName.size() <= 120
        && data.items is list && data.items.size() > 0 && data.items.size() <= 100 && data.items[0] is map
        && data.totalAmount is number && data.totalAmount >= 0
        && data.paidAmount is number && data.paidAmount >= 0
        && data.status in ['paid', 'credit']
        && isOptString(data, 'note', 240)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStockLog(data, shopId) {
      return data.keys().hasAll(['ownerId', 'productId', 'productName', 'type', 'quantity', 'previousStock', 'newStock', 'reason', 'date', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'productId', 'productName', 'type', 'quantity', 'previousStock', 'newStock', 'reason', 'date', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == shopId
        && (data.ownerId == request.auth.uid || isAdmin())
        && isValidId(data.productId)
        && data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 140
        && data.type in ['in', 'out', 'adjust']
        && data.quantity is number
        && data.previousStock is number
        && data.newStock is number
        && data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 200
        && isValidDateString(data.date)
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidDebt(data, shopId) {
      return data.keys().hasAll(['ownerId', 'type', 'partyName', 'totalAmount', 'paidAmount', 'remainingAmount', 'dueDate', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'type', 'partyName', 'phone', 'referenceNo', 'totalAmount', 'paidAmount', 'remainingAmount', 'dueDate', 'status', 'note', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == shopId
        && (data.ownerId == request.auth.uid || isAdmin())
        && data.type in ['receivable', 'payable']
        && data.partyName is string && data.partyName.size() >= 1 && data.partyName.size() <= 120
        && isOptString(data, 'phone', 40)
        && isOptString(data, 'referenceNo', 48)
        && data.totalAmount is number && data.totalAmount >= 0
        && data.paidAmount is number && data.paidAmount >= 0
        && data.remainingAmount is number && data.remainingAmount >= 0
        && isValidDateString(data.dueDate)
        && data.status in ['pending', 'partial', 'settled']
        && isOptString(data, 'note', 240)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExpense(data, shopId) {
      return data.keys().hasAll(['ownerId', 'date', 'category', 'title', 'amount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'date', 'category', 'title', 'amount', 'note', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == shopId
        && (data.ownerId == request.auth.uid || isAdmin())
        && isValidDateString(data.date)
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 64
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.amount is number && data.amount >= 0
        && isOptString(data, 'note', 240)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDelivery(data, shopId) {
      return data.keys().hasAll(['ownerId', 'voucherNo', 'date', 'customerName', 'address', 'courierName', 'deliveryFee', 'codAmount', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'voucherNo', 'date', 'customerName', 'phone', 'address', 'courierName', 'deliveryFee', 'codAmount', 'status', 'note', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == shopId
        && (data.ownerId == request.auth.uid || isAdmin())
        && data.voucherNo is string && data.voucherNo.size() >= 1 && data.voucherNo.size() <= 48
        && isValidDateString(data.date)
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120
        && isOptString(data, 'phone', 40)
        && data.address is string && data.address.size() >= 1 && data.address.size() <= 240
        && data.courierName is string && data.courierName.size() >= 1 && data.courierName.size() <= 80
        && data.deliveryFee is number && data.deliveryFee >= 0
        && data.codAmount is number && data.codAmount >= 0
        && data.status in ['pending', 'dispatched', 'delivered', 'cancelled']
        && isOptString(data, 'note', 240)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Admin Registry Collection (Primary Admin Managed)
    // -------------------------------------------------------------------------
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (adminUid == request.auth.uid || isPrimaryAdmin());
      allow list: if isPrimaryAdmin();
      allow create, update, delete: if isPrimaryAdmin() && isValidId(adminUid);
    }

    // -------------------------------------------------------------------------
    // Admin-Issued Random Access Passes Collection
    // -------------------------------------------------------------------------
    match /accessPasses/{passCode} {
      allow get: if isValidPassCode(passCode) && (
        isAdmin() ||
        (isVerified()
          && (!('assignedUid' in resource.data) || resource.data.assignedUid == '' || resource.data.assignedUid == request.auth.uid)
          && (!('assignedEmail' in resource.data) || resource.data.assignedEmail == '' || resource.data.assignedEmail == request.auth.token.email))
      );
      allow list: if isPrimaryAdmin() || (isVerified() && resource.data.assignedEmail == request.auth.token.email);

      allow create: if isAdmin()
        && isValidPassCode(passCode)
        && isValidAccessPass(incoming())
        && incoming().code == passCode
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidPassCode(passCode)
        && isValidAccessPass(incoming())
        && incoming().code == existing().code
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isVerified()
            && existing().status == 'active'
            && isNotExpiredDoc(existing())
            && (!('assignedUid' in existing()) || existing().assignedUid == '' || existing().assignedUid == request.auth.uid)
            && (!('assignedEmail' in existing()) || existing().assignedEmail == '' || existing().assignedEmail == request.auth.token.email)
            && incoming().assignedUid == request.auth.uid
            && incoming().assignedEmail == request.auth.token.email
            && incoming().boundDevices.size() >= 1
            && incoming().boundDevices.size() <= existing().maxDevices
            && incoming().boundDevices.hasAll(existing().boundDevices)
            && incoming().diff(existing()).affectedKeys().hasOnly(['assignedUid', 'assignedEmail', 'boundDevices', 'updatedAt'])
            && existsAfter(/databases/$(database)/documents/userLicenses/$(request.auth.uid))
          )
        );

      allow delete: if isAdmin() && isValidPassCode(passCode);
    }

    // -------------------------------------------------------------------------
    // Per-User Active Access License Collection (Server-Verified Expiry)
    // -------------------------------------------------------------------------
    match /userLicenses/{userId} {
      allow get: if isValidId(userId) && (isAdmin() || (isSignedIn() && userId == request.auth.uid));
      allow list: if isPrimaryAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isValidId(userId)
        && isValidUserLicense(incoming())
        && incoming().userId == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isVerified()
            && userId == request.auth.uid
            && incoming().email == request.auth.token.email
            && incoming().status == 'active'
            && existsAfter(/databases/$(database)/documents/accessPasses/$(incoming().passCode))
            && getAfter(/databases/$(database)/documents/accessPasses/$(incoming().passCode)).data.status == 'active'
            && isNotExpiredDoc(getAfter(/databases/$(database)/documents/accessPasses/$(incoming().passCode)).data)
            && getAfter(/databases/$(database)/documents/accessPasses/$(incoming().passCode)).data.assignedUid == request.auth.uid
            && incoming().expiresAt == getAfter(/databases/$(database)/documents/accessPasses/$(incoming().passCode)).data.expiresAt
            && (
              !('subscription_expiry' in incoming())
              || ('subscription_expiry' in getAfter(/databases/$(database)/documents/accessPasses/$(incoming().passCode)).data && incoming().subscription_expiry == getAfter(/databases/$(database)/documents/accessPasses/$(incoming().passCode)).data.subscription_expiry)
              || (!('subscription_expiry' in getAfter(/databases/$(database)/documents/accessPasses/$(incoming().passCode)).data) && incoming().subscription_expiry == getAfter(/databases/$(database)/documents/accessPasses/$(incoming().passCode)).data.expiresAt)
            )
            && incoming().maxDevices == getAfter(/databases/$(database)/documents/accessPasses/$(incoming().passCode)).data.maxDevices
          )
        );

      allow update: if isValidId(userId)
        && isValidUserLicense(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isVerified()
            && userId == request.auth.uid
            && incoming().email == request.auth.token.email
            && incoming().status == 'active'
            && incoming().diff(existing()).affectedKeys().hasOnly(['passCode', 'label', 'status', 'expiresAt', 'subscription_expiry', 'maxDevices', 'updatedAt'])
            && existsAfter(/databases/$(database)/documents/accessPasses/$(incoming().passCode))
            && getAfter(/databases/$(database)/documents/accessPasses/$(incoming().passCode)).data.status == 'active'
            && isNotExpiredDoc(getAfter(/databases/$(database)/documents/accessPasses/$(incoming().passCode)).data)
            && getAfter(/databases/$(database)/documents/accessPasses/$(incoming().passCode)).data.assignedUid == request.auth.uid
            && incoming().expiresAt == getAfter(/databases/$(database)/documents/accessPasses/$(incoming().passCode)).data.expiresAt
            && (
              !('subscription_expiry' in incoming())
              || ('subscription_expiry' in getAfter(/databases/$(database)/documents/accessPasses/$(incoming().passCode)).data && incoming().subscription_expiry == getAfter(/databases/$(database)/documents/accessPasses/$(incoming().passCode)).data.subscription_expiry)
              || (!('subscription_expiry' in getAfter(/databases/$(database)/documents/accessPasses/$(incoming().passCode)).data) && incoming().subscription_expiry == getAfter(/databases/$(database)/documents/accessPasses/$(incoming().passCode)).data.expiresAt)
            )
            && incoming().maxDevices == getAfter(/databases/$(database)/documents/accessPasses/$(incoming().passCode)).data.maxDevices
          )
        );

      allow delete: if isAdmin() && isValidId(userId);
    }

    // -------------------------------------------------------------------------
    // Root Shop Profile & Settings Collection
    // -------------------------------------------------------------------------
    match /shops/{shopId} {
      allow get: if isSignedIn() && isValidId(shopId) && ((shopId == request.auth.uid && hasActiveLicense()) || isAdmin());
      allow list: if isPrimaryAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);

      allow create: if isVerified()
        && isValidId(shopId)
        && (isAdmin() || (shopId == request.auth.uid && hasActiveLicense()))
        && isValidShop(incoming(), shopId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(shopId)
        && isValidShop(incoming(), shopId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (shopId == request.auth.uid && hasActiveLicense() && incoming().diff(existing()).affectedKeys().hasOnly(['shopName', 'shopSubtitle', 'phone', 'address', 'receiptFooter', 'defaultMarginPercent', 'telegramEnabled', 'updatedAt']))
        );

      allow delete: if isAdmin() && isValidId(shopId);

      // -----------------------------------------------------------------------
      // Products Subcollection
      // -----------------------------------------------------------------------
      match /products/{productId} {
        allow get: if isSignedIn() && isValidId(shopId) && isValidId(productId) && (isShopOwner(shopId) || isAdmin());
        allow list: if isPrimaryAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);

        allow create: if isVerified()
          && isValidId(shopId)
          && isValidId(productId)
          && isValidProduct(incoming(), shopId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (isShopOwner(shopId) || isAdmin());

        allow update: if isVerified()
          && isValidId(shopId)
          && isValidId(productId)
          && isValidProduct(incoming(), shopId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (isShopOwner(shopId) && incoming().diff(existing()).affectedKeys().hasOnly(['sku', 'name', 'category', 'unit', 'costPrice', 'marginPercent', 'sellPrice', 'stock', 'minStock', 'updatedAt']))
          );

        allow delete: if isVerified() && isValidId(shopId) && isValidId(productId) && (isShopOwner(shopId) || isAdmin());
      }

      // -----------------------------------------------------------------------
      // Sales Subcollection (Full Owner CRUD)
      // -----------------------------------------------------------------------
      match /sales/{saleId} {
        allow get: if isSignedIn() && isValidId(shopId) && isValidId(saleId) && (isShopOwner(shopId) || isAdmin());
        allow list: if isPrimaryAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);

        allow create: if isVerified()
          && isValidId(shopId)
          && isValidId(saleId)
          && isValidSale(incoming(), shopId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (isShopOwner(shopId) || isAdmin());

        allow update: if isVerified()
          && isValidId(shopId)
          && isValidId(saleId)
          && isValidSale(incoming(), shopId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (isShopOwner(shopId) && incoming().diff(existing()).affectedKeys().hasOnly(['voucherNo', 'date', 'customerName', 'customerPhone', 'paymentMethod', 'items', 'subtotal', 'discount', 'total', 'totalCost', 'profit', 'paidAmount', 'note', 'updatedAt']))
          );

        allow delete: if isVerified() && isValidId(shopId) && isValidId(saleId) && (isShopOwner(shopId) || isAdmin());
      }

      // -----------------------------------------------------------------------
      // Purchases Subcollection (Full Owner CRUD)
      // -----------------------------------------------------------------------
      match /purchases/{purchaseId} {
        allow get: if isSignedIn() && isValidId(shopId) && isValidId(purchaseId) && (isShopOwner(shopId) || isAdmin());
        allow list: if isPrimaryAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);

        allow create: if isVerified()
          && isValidId(shopId)
          && isValidId(purchaseId)
          && isValidPurchase(incoming(), shopId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (isShopOwner(shopId) || isAdmin());

        allow update: if isVerified()
          && isValidId(shopId)
          && isValidId(purchaseId)
          && isValidPurchase(incoming(), shopId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (isShopOwner(shopId) && incoming().diff(existing()).affectedKeys().hasOnly(['refNo', 'date', 'supplierName', 'items', 'totalAmount', 'paidAmount', 'status', 'note', 'updatedAt']))
          );

        allow delete: if isVerified() && isValidId(shopId) && isValidId(purchaseId) && (isShopOwner(shopId) || isAdmin());
      }

      // -----------------------------------------------------------------------
      // Stock Logs Subcollection (Full Owner CRUD)
      // -----------------------------------------------------------------------
      match /stockLogs/{logId} {
        allow get: if isSignedIn() && isValidId(shopId) && isValidId(logId) && (isShopOwner(shopId) || isAdmin());
        allow list: if isPrimaryAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);

        allow create: if isVerified()
          && isValidId(shopId)
          && isValidId(logId)
          && isValidStockLog(incoming(), shopId)
          && incoming().createdAt == request.time
          && (isShopOwner(shopId) || isAdmin());

        allow update: if isVerified()
          && isValidId(shopId)
          && isValidId(logId)
          && isValidStockLog(incoming(), shopId)
          && incoming().ownerId == existing().ownerId
          && incoming().productId == existing().productId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (isShopOwner(shopId) && incoming().diff(existing()).affectedKeys().hasOnly(['productName', 'type', 'quantity', 'previousStock', 'newStock', 'reason', 'date', 'updatedAt']))
          );

        allow delete: if isVerified() && isValidId(shopId) && isValidId(logId) && (isShopOwner(shopId) || isAdmin());
      }

      // -----------------------------------------------------------------------
      // Debts Subcollection (Full Owner CRUD)
      // -----------------------------------------------------------------------
      match /debts/{debtId} {
        allow get: if isSignedIn() && isValidId(shopId) && isValidId(debtId) && (isShopOwner(shopId) || isAdmin());
        allow list: if isPrimaryAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);

        allow create: if isVerified()
          && isValidId(shopId)
          && isValidId(debtId)
          && isValidDebt(incoming(), shopId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (isShopOwner(shopId) || isAdmin());

        allow update: if isVerified()
          && isValidId(shopId)
          && isValidId(debtId)
          && isValidDebt(incoming(), shopId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (isShopOwner(shopId) && incoming().diff(existing()).affectedKeys().hasOnly(['type', 'partyName', 'phone', 'referenceNo', 'totalAmount', 'paidAmount', 'remainingAmount', 'dueDate', 'status', 'note', 'updatedAt']))
          );

        allow delete: if isVerified() && isValidId(shopId) && isValidId(debtId) && (isShopOwner(shopId) || isAdmin());
      }

      // -----------------------------------------------------------------------
      // Expenses Subcollection (Full Owner CRUD)
      // -----------------------------------------------------------------------
      match /expenses/{expenseId} {
        allow get: if isSignedIn() && isValidId(shopId) && isValidId(expenseId) && (isShopOwner(shopId) || isAdmin());
        allow list: if isPrimaryAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);

        allow create: if isVerified()
          && isValidId(shopId)
          && isValidId(expenseId)
          && isValidExpense(incoming(), shopId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (isShopOwner(shopId) || isAdmin());

        allow update: if isVerified()
          && isValidId(shopId)
          && isValidId(expenseId)
          && isValidExpense(incoming(), shopId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (isShopOwner(shopId) && incoming().diff(existing()).affectedKeys().hasOnly(['date', 'category', 'title', 'amount', 'note', 'updatedAt']))
          );

        allow delete: if isVerified() && isValidId(shopId) && isValidId(expenseId) && (isShopOwner(shopId) || isAdmin());
      }

      // -----------------------------------------------------------------------
      // Deliveries Subcollection (Full Owner CRUD)
      // -----------------------------------------------------------------------
      match /deliveries/{deliveryId} {
        allow get: if isSignedIn() && isValidId(shopId) && isValidId(deliveryId) && (isShopOwner(shopId) || isAdmin());
        allow list: if isPrimaryAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);

        allow create: if isVerified()
          && isValidId(shopId)
          && isValidId(deliveryId)
          && isValidDelivery(incoming(), shopId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (isShopOwner(shopId) || isAdmin());

        allow update: if isVerified()
          && isValidId(shopId)
          && isValidId(deliveryId)
          && isValidDelivery(incoming(), shopId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (isShopOwner(shopId) && incoming().diff(existing()).affectedKeys().hasOnly(['voucherNo', 'date', 'customerName', 'phone', 'address', 'courierName', 'deliveryFee', 'codAmount', 'status', 'note', 'updatedAt']))
          );

        allow delete: if isVerified() && isValidId(shopId) && isValidId(deliveryId) && (isShopOwner(shopId) || isAdmin());
      }
    }
  }
}
