# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Telegram Bot Integration (Server-side proxy /api/telegram/*)
# Obtain Bot Token from @BotFather and Chat ID from @userinfobot or your channel
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Supabase Integration (Optional dual-database sync via server-side proxy /api/supabase/*)
# Create a project at https://supabase.com and run supabase_schema.sql in SQL Editor
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
# Optional: Server-side Service Role Key bypasses RLS automatically
SUPABASE_SERVICE_ROLE_KEY=""
